#pragma code_page(65001)
#include <windows.h>
#include "Resource.h"
#include "Version.h"

IDI_VIDEOWALLPAPER ICON "VideoWallpaper.ico"
IDI_SMALL          ICON "small.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VW_VERSION_RC
 PRODUCTVERSION VW_VERSION_RC
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Video Wallpaper"
            VALUE "FileVersion",     VW_VERSION_STR
            VALUE "ProductName",     "Video Wallpaper"
            VALUE "ProductVersion",  VW_VERSION_STR
            VALUE "OriginalFilename","videowallpaper.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
