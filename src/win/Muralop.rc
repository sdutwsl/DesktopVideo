#pragma code_page(65001)
#include <windows.h>
#include "Resource.h"
#include "Version.h"

IDI_MURALOP ICON "Muralop.ico"
IDI_SMALL          ICON "small.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MURALOP_VERSION_RC
 PRODUCTVERSION MURALOP_VERSION_RC
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Muralop"
            VALUE "FileVersion",     MURALOP_VERSION_STR
            VALUE "ProductName",     "Muralop"
            VALUE "ProductVersion",  MURALOP_VERSION_STR
            VALUE "OriginalFilename","muralop.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
